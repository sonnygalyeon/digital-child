# Public gateway exposed only to your local network.
WINDOWS_HOST_BIND=0.0.0.0
WINDOWS_HOST_PORT=8787

# Generate a long random value. The setup script fills this automatically.
WINDOWS_HOST_API_KEY=replace-with-a-long-random-token

# Ollama remains private on the Windows host.
WINDOWS_HOST_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
WINDOWS_HOST_DEFAULT_MODEL=qwen3:8b
WINDOWS_HOST_ALLOWED_MODELS=qwen3:8b,qwen3:4b
WINDOWS_HOST_REQUEST_TIMEOUT=300
WINDOWS_HOST_MAX_REQUEST_BYTES=4194304

# PostgreSQL is optional. Leave empty to disable DB audit logging.
WINDOWS_HOST_POSTGRES_DSN=
WINDOWS_HOST_STORE_CONTENT=false
WINDOWS_HOST_LOG_REQUESTS=true

# Human-readable client label written to audit metadata.
WINDOWS_HOST_INSTANCE_NAME=windows-5700x
