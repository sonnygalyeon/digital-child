# LLM provider: ollama | llamacpp | openai-compatible | disabled
# For the separate Windows host use openai-compatible and its LAN address.
DIGITAL_CHILD_LLM_PROVIDER=openai-compatible
DIGITAL_CHILD_LLM_BASE_URL=http://192.168.1.50:8787/v1
DIGITAL_CHILD_LLM_MODEL=digital-child-fast
DIGITAL_CHILD_LLM_API_KEY=copy-key-from-windows_host-dotenv
DIGITAL_CHILD_LLM_TIMEOUT=180
DIGITAL_CHILD_LLM_TEMPERATURE=0.45
DIGITAL_CHILD_LLM_TOP_P=0.90
DIGITAL_CHILD_LLM_MAX_TOKENS=512
DIGITAL_CHILD_LLM_REASONING_EFFORT=none

# Balanced routing. Empty model names inherit main/fast; nothing is downloaded.
DIGITAL_CHILD_LLM_PROFILE=balanced
DIGITAL_CHILD_LLM_FAST_MODEL=
DIGITAL_CHILD_LLM_REASONING_MODEL=
DIGITAL_CHILD_LLM_ANALYSIS_MODEL=
DIGITAL_CHILD_LLM_REVIEW_MODEL=
DIGITAL_CHILD_LLM_MEMORY_MODEL=
DIGITAL_CHILD_LLM_SOURCES_MODEL=
# auto = thinking only for complex replies with an explicit reasoning model; off | fixed.
DIGITAL_CHILD_LLM_REASONING_MODE=auto
DIGITAL_CHILD_LLM_DEEP_REASONING_EFFORT=low
# Increase together with WINDOWS_HOST_MAX_OUTPUT_TOKENS when enabling a thinking model.
DIGITAL_CHILD_LLM_DEEP_MAX_TOKENS=512
# Disable optional fields for compatible endpoints that reject them.
DIGITAL_CHILD_LLM_SEND_REASONING_EFFORT=1
DIGITAL_CHILD_LLM_JSON_MODE=1
DIGITAL_CHILD_LLM_QUEUE_TIMEOUT=10
DIGITAL_CHILD_LLM_FAILURE_COOLDOWN=20
DIGITAL_CHILD_LLM_HEALTH_CACHE_SECONDS=30
DIGITAL_CHILD_LLM_HEALTH_TIMEOUT=3
DIGITAL_CHILD_LLM_SOURCES_TIMEOUT=30
DIGITAL_CHILD_LLM_INITIATIVE_TIMEOUT=30

# Compact context reduces prompt-evaluation latency on CPU.
DIGITAL_CHILD_LLM_HISTORY_MESSAGES=6
DIGITAL_CHILD_LLM_MEMORY_ITEMS=4
DIGITAL_CHILD_LLM_BELIEF_ITEMS=4
DIGITAL_CHILD_LLM_PROMPT_MAX_CHARS=7000
DIGITAL_CHILD_LLM_INPUT_MAX_CHARS=3000

# Research: wikipedia | generic | disabled
DIGITAL_CHILD_RESEARCH_PROVIDER=wikipedia
DIGITAL_CHILD_AUTO_RESEARCH=1
# background = answer first, verify later; blocking = wait; manual = only /research
DIGITAL_CHILD_RESEARCH_MODE=background
DIGITAL_CHILD_WIKIPEDIA_LANGUAGE=ru

DIGITAL_CHILD_SEARCH_ENDPOINT=
DIGITAL_CHILD_SEARCH_API_KEY=
DIGITAL_CHILD_OPERATOR_TOKEN=change-me
DIGITAL_CHILD_DB=data/digital_child.db

# Autonomous cognitive loop v0.5.0
DIGITAL_CHILD_COGNITIVE_HEARTBEAT_SECONDS=5
DIGITAL_CHILD_MAX_SELF_GOALS_PER_DAY=8
DIGITAL_CHILD_MAX_BACKGROUND_CYCLES_PER_DAY=10000
DIGITAL_CHILD_MAX_INITIATIVE_MESSAGES_PER_DAY=5

# Spontaneous chat while the application/API process is running.
# Emotional longing starts after 24h since the last real human message.
DIGITAL_CHILD_INITIATIVE_ENABLED=1
DIGITAL_CHILD_INITIATIVE_POLL_SECONDS=15
DIGITAL_CHILD_DISCUSSION_DELAY_SECONDS=120
DIGITAL_CHILD_INITIATIVE_COOLDOWN_SECONDS=900
DIGITAL_CHILD_INTEREST_DELAY_SECONDS=3600
DIGITAL_CHILD_RECONNECT_COOLDOWN_SECONDS=86400
DIGITAL_CHILD_MAX_UNANSWERED_INITIATIVES=2

# UTC from HTTPS Date; offline mode uses system time plus the saved correction.
DIGITAL_CHILD_TIME_SYNC=1
DIGITAL_CHILD_TIME_URL=https://www.wikipedia.org/
DIGITAL_CHILD_TIME_TIMEOUT=3
DIGITAL_CHILD_TIME_SYNC_SECONDS=3600

# Persistent factual checks retry after reconnection/restart; 0 disables automatic attempts.
DIGITAL_CHILD_MAX_DEFERRED_CHECKS_PER_DAY=8

# Structured interpretation and review use the configured LLM; rules remain available offline.
DIGITAL_CHILD_SEMANTIC_ANALYSIS=1
DIGITAL_CHILD_ANALYSIS_MODE=adaptive
DIGITAL_CHILD_SEMANTIC_REPLY_REVIEW=1
DIGITAL_CHILD_ANALYSIS_TIMEOUT=10

# Closed numerical experiments: daily total includes manual and autonomous trials.
DIGITAL_CHILD_AUTO_EXPERIMENTS=1
DIGITAL_CHILD_MAX_EXPERIMENTS_PER_DAY=8
DIGITAL_CHILD_MAX_AUTO_EXPERIMENTS_PER_DAY=2

# Default offset for communication quiet hours, in minutes (Moscow = 180).
DIGITAL_CHILD_UTC_OFFSET_MINUTES=180

# Associative memory: optional LLM concept labels, with an independent daily budget.
DIGITAL_CHILD_SEMANTIC_MEMORY=1
DIGITAL_CHILD_MAX_MEMORY_ANALYSES_PER_DAY=20

# Resource recovery during an active idle loop; no developmental experience is awarded.
DIGITAL_CHILD_AUTO_REGULATION=1
DIGITAL_CHILD_MAX_REGULATED_RESTS_PER_DAY=4

# Time-based emotions: seconds; state and transition causes persist in SQLite.
DIGITAL_CHILD_EMOTION_HALF_LIFE_SECONDS=900
DIGITAL_CHILD_EMOTION_MIN_HOLD_SECONDS=8
DIGITAL_CHILD_EMOTION_SETTLE_SECONDS=3
DIGITAL_CHILD_EMOTION_SWITCH_MARGIN=0.15

# Short numerical action plans; no LLM or external tool execution is required.
DIGITAL_CHILD_AUTO_PLANS=1
DIGITAL_CHILD_PLAN_STEP_SECONDS=60
DIGITAL_CHILD_MAX_PLANS_PER_DAY=4
DIGITAL_CHILD_MAX_PLAN_STEPS_PER_DAY=32
DIGITAL_CHILD_MAX_AUTO_PLANS_PER_DAY=1
DIGITAL_CHILD_MAX_AUTO_PLAN_STEPS_PER_DAY=8
