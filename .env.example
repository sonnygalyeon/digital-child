# LLM provider: ollama | llamacpp | openai-compatible | disabled
# For the separate Windows host use openai-compatible and its LAN address.
DIGITAL_CHILD_LLM_PROVIDER=openai-compatible
DIGITAL_CHILD_LLM_BASE_URL=http://192.168.1.50:8787/v1
DIGITAL_CHILD_LLM_MODEL=digital-child-fast
DIGITAL_CHILD_LLM_API_KEY=copy-key-from-windows_host-dotenv
DIGITAL_CHILD_LLM_TIMEOUT=180
DIGITAL_CHILD_LLM_TEMPERATURE=0.45
DIGITAL_CHILD_LLM_TOP_P=0.90
DIGITAL_CHILD_LLM_MAX_TOKENS=512
DIGITAL_CHILD_LLM_REASONING_EFFORT=none

# Compact context reduces prompt-evaluation latency on CPU.
DIGITAL_CHILD_LLM_HISTORY_MESSAGES=6
DIGITAL_CHILD_LLM_MEMORY_ITEMS=4
DIGITAL_CHILD_LLM_BELIEF_ITEMS=4
DIGITAL_CHILD_LLM_PROMPT_MAX_CHARS=7000

# Research: wikipedia | generic | disabled
DIGITAL_CHILD_RESEARCH_PROVIDER=wikipedia
DIGITAL_CHILD_AUTO_RESEARCH=1
# background = answer first, verify later; blocking = wait; manual = only /research
DIGITAL_CHILD_RESEARCH_MODE=background
DIGITAL_CHILD_WIKIPEDIA_LANGUAGE=ru

DIGITAL_CHILD_SEARCH_ENDPOINT=
DIGITAL_CHILD_SEARCH_API_KEY=
DIGITAL_CHILD_OPERATOR_TOKEN=change-me
DIGITAL_CHILD_DB=data/digital_child.db

# Autonomous cognitive loop v0.5.0
DIGITAL_CHILD_COGNITIVE_HEARTBEAT_SECONDS=5
DIGITAL_CHILD_MAX_SELF_GOALS_PER_DAY=8
DIGITAL_CHILD_MAX_BACKGROUND_CYCLES_PER_DAY=10000
DIGITAL_CHILD_MAX_INITIATIVE_MESSAGES_PER_DAY=5

# Spontaneous chat while the application/API process is running.
# Emotional longing starts after 24h since the last real human message.
DIGITAL_CHILD_INITIATIVE_ENABLED=1
DIGITAL_CHILD_INITIATIVE_POLL_SECONDS=15
DIGITAL_CHILD_DISCUSSION_DELAY_SECONDS=120
DIGITAL_CHILD_INITIATIVE_COOLDOWN_SECONDS=900
DIGITAL_CHILD_INTEREST_DELAY_SECONDS=3600
DIGITAL_CHILD_RECONNECT_COOLDOWN_SECONDS=86400
DIGITAL_CHILD_MAX_UNANSWERED_INITIATIVES=2

# UTC from HTTPS Date; offline mode uses system time plus the saved correction.
DIGITAL_CHILD_TIME_SYNC=1
DIGITAL_CHILD_TIME_URL=https://www.wikipedia.org/
DIGITAL_CHILD_TIME_TIMEOUT=3
DIGITAL_CHILD_TIME_SYNC_SECONDS=3600

# Persistent factual checks retry after reconnection/restart; 0 disables automatic attempts.
DIGITAL_CHILD_MAX_DEFERRED_CHECKS_PER_DAY=8
